{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Prepare FULLPOS Windows Hot Reload",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-Command",
				"Get-Process fullpos -ErrorAction SilentlyContinue | Stop-Process -Force; exit 0"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": []
		},
		{
			"label": "Run FULLPOS Debug Windows",
			"type": "shell",
			"command": "flutter",
			"args": [
				"run",
				"-d",
				"windows",
				"--debug"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"isBackground": false
		},
		{
			"label": "Run FULLPOS Debug Windows 2",
			"type": "shell",
			"command": "flutter",
			"args": [
				"run",
				"-d",
				"windows",
				"--debug"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"isBackground": false
		}
	]
}